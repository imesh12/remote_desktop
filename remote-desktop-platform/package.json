{
  "name": "remote-desktop-platform",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @remote-desktop/server --filter @remote-desktop/web dev",
    "typecheck": "pnpm -r typecheck"
  }
}
